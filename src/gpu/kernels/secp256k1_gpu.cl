inline void sub_mod(uint* R, const uint* A, const uint* B) {
    ulong br = 0;
    for(int i=0; i<8; i++) {
        ulong sub = (ulong)A[i] - B[i] - br;
        R[i] = (uint)sub;
        br = (sub >> 32) & 1;
    }
    if (br) {
        ulong c = 0;
        for(int i=0; i<8; i++) {
            ulong sum = (ulong)R[i] + P[i] + c;
            R[i] = (uint)sum;
            c = sum >> 32;
        }
    }
}

inline void mul_mod(uint* R, const uint* A, const uint* B) {
    ulong C[16];
    for(int i=0; i<16; i++) C[i] = 0;
    for(int i=0; i<8; i++) {
        ulong carry = 0;
        for(int j=0; j<8; j++) {
            ulong prod = (ulong)A[i] * B[j] + C[i+j] + carry;
            C[i+j] = (uint)prod;
            carry = prod >> 32;
        }
        C[i+8] += carry;
    }
    
    ulong carry = 0;
    uint R_tmp[8];
    for(int i=0; i<8; i++) {
        ulong term1 = C[i];
        ulong term2 = (ulong)C[i+8] * 0x3D1UL;
        ulong term3 = (i > 0) ? C[i+7] : 0;
        ulong sum = term1 + term2 + term3 + carry;
        R_tmp[i] = (uint)sum;
        carry = sum >> 32;
    }
    carry += C[15];
    
    ulong c2 = 0;
    for(int i=0; i<8; i++) {
        ulong term2 = (i==0) ? (carry * 0x3D1UL) : 0;
        ulong term3 = (i==1) ? carry : 0;
        ulong sum = (ulong)R_tmp[i] + term2 + term3 + c2;
        R_tmp[i] = (uint)sum;
        c2 = sum >> 32;
    }
    
    if (c2 > 0) {
        ulong c3 = 0;
        ulong sum = (ulong)R_tmp[0] + (c2 * 0x3D1UL) + c3; R_tmp[0] = (uint)sum; c3 = sum >> 32;
        sum = (ulong)R_tmp[1] + c2 + c3; R_tmp[1] = (uint)sum; c3 = sum >> 32;
        for(int i=2; i<8; i++) {
            if (c3 == 0) break;
            sum = (ulong)R_tmp[i] + c3; R_tmp[i] = (uint)sum; c3 = sum >> 32;
        }
    }
    
    bool gte = true;
    for(int i=7; i>=0; i--) {
        if (R_tmp[i] > P[i]) break;
        if (R_tmp[i] < P[i]) { gte = false; break; }
    }
    if (gte) {
        ulong br = 0;
        for(int i=0; i<8; i++) {
            ulong sub = (ulong)R_tmp[i] - P[i] - br;
            R_tmp[i] = (uint)sub;
            br = (sub >> 32) & 1;
        }
    }
    
    for(int i=0; i<8; i++) R[i] = R_tmp[i];
}

inline void inv_mod(uint* R, const uint* A) {
    uint res[8] = {1,0,0,0,0,0,0,0};
    uint base[8];
    for(int i=0; i<8; i++) base[i] = A[i];
    
    for(int i=0; i<256; i++) {
        int word = i / 32;
        int bit = i % 32;
        if ((P_MINUS_2[word] >> bit) & 1) {
            mul_mod(res, res, base);
        }
        mul_mod(base, base, base);
    }
    for(int i=0; i<8; i++) R[i] = res[i];
}

inline void point_add_mixed(uint* X1, uint* Y1, uint* Z1, __constant const uint* X2, __constant const uint* Y2) {
    uint lx2[8], ly2[8];
    for(int i=0; i<8; i++) { lx2[i] = X2[i]; ly2[i] = Y2[i]; }
    bool z1_zero = true;
    for(int i=0; i<8; i++) if (Z1[i] != 0) z1_zero = false;
    if (z1_zero) {
        for(int i=0; i<8; i++) { X1[i] = lx2[i]; Y1[i] = ly2[i]; Z1[i] = (i==0)?1:0; }
        return;
    }
    
    uint T1[8], T2[8], T3[8], T4[8], H[8], R[8];
    bool z1_is_one = (Z1[0] == 1);
    for (int i=1; i<8; i++) if (Z1[i] != 0) z1_is_one = false;

    if (z1_is_one) {
        sub_mod(H, lx2, X1);
        sub_mod(R, ly2, Y1);
        for(int i=0; i<8; i++) Z1[i] = H[i];
    } else {
        mul_mod(T1, Z1, Z1); 
        mul_mod(T2, lx2, T1);
        mul_mod(T3, T1, Z1);
        mul_mod(T4, ly2, T3);
        sub_mod(H, T2, X1);
        sub_mod(R, T4, Y1);
        mul_mod(Z1, H, Z1);
    }
    
    mul_mod(T1, H, H);
    mul_mod(T2, T1, H);
    mul_mod(T3, X1, T1);
    
    mul_mod(X1, R, R);
    sub_mod(X1, X1, T2);
    sub_mod(X1, X1, T3);
    sub_mod(X1, X1, T3);
    
    sub_mod(T4, T3, X1);
    mul_mod(T4, R, T4);
    mul_mod(T3, Y1, T2);
    sub_mod(Y1, T4, T3);
}

__kernel void test_secp256k1(__global const uint* priv_key, __global uint* pub_x, __global uint* pub_y) {
    uint X[8]={0}, Y[8]={0}, Z[8]={0};
    
    uint key[8];
    for(int i=0; i<8; i++) key[i] = priv_key[i];
    
    for(int i=0; i<256; i++) {
        int word = i / 32;
        int bit = i % 32;
        if ((key[word] >> bit) & 1) {
            point_add_mixed(X, Y, Z, G_TABLE[i][0], G_TABLE[i][1]);
        }
    }
    
    uint Z2[8], Z3[8], Zinv[8];
    inv_mod(Zinv, Z);
    mul_mod(Z2, Zinv, Zinv);
    mul_mod(Z3, Z2, Zinv);
    
    uint X_aff[8], Y_aff[8];
    mul_mod(X_aff, X, Z2);
    mul_mod(Y_aff, Y, Z3);
    
    for(int i=0; i<8; i++) {
        pub_x[i] = X_aff[i];
        pub_y[i] = Y_aff[i];
    }
}
